# Auto-detect text files and normalize line endings
* text=auto

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.ico binary
*.webp binary
*.bmp binary
*.psd binary
# SVG is XML text, not binary
*.svg text

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Archives
*.7z binary
*.bz2 binary
*.gz binary
*.rar binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.zip binary
*.zst binary

# Compiled objects and libraries
*.a binary
*.lib binary
*.o binary
*.obj binary

# Executables and shared libraries
*.dll binary
*.dylib binary
*.exe binary
*.so binary

# Documents and data
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Preserve byte sequences in patches
*.patch -text
*.diff -text

# Audio
*.aac binary
*.aif binary
*.aiff binary
*.flac binary
*.m4a binary
*.mid binary
*.midi binary
*.mp3 binary
*.ogg binary
*.wav binary
*.wma binary

# Video
*.3gp binary
*.avi binary
*.flv binary
*.m4v binary
*.mkv binary
*.mov binary
*.mp4 binary
*.mpeg binary
*.mpg binary
*.ogv binary
*.webm binary
*.wmv binary

# Lockfiles
uv.lock binary
Pipfile.lock binary
poetry.lock binary

# Python bytecode and data (Python.gitattributes, CPython)
*.pyc binary
*.pyo binary
*.pyd binary
*.whl binary
*.pkl binary
*.pickle binary

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ksh text eol=lf

# Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text

# Suppress diffs for minified files (CPython, Docusaurus)
*.min.js -diff
*.min.css -diff

# Diff attributes for better readability
*.c diff=cpp
*.h diff=cpp
*.cpp diff=cpp
*.cc diff=cpp
*.css diff=css
*.scss diff=css
*.html diff=html
*.md diff=markdown
*.tex diff=tex

# Document diffs via text extraction
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain

# Jupyter notebooks (Web.gitattributes, Python.gitattributes)
*.ipynb text eol=lf

# Python diff driver
*.py text diff=python
*.pyx text diff=python

# Linguist: mark generated files
uv.lock linguist-generated=true
Pipfile.lock linguist-generated=true
poetry.lock linguist-generated=true

# Changelogs — append-only merge avoids conflicts
CHANGELOG.md merge=union
CHANGES.md merge=union

# Exclude from archives
.github/ export-ignore
.gitlab/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
